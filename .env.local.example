# ── Supabase ────────────────────────────────────────────────────────────────
# Copiá este archivo a .env.local y pegá los valores de tu proyecto.
# Los encontrás en: Supabase → Project Settings → API
#
# Mientras estas dos variables estén vacías, el CRM arranca en MODO DEMO
# (datos de ejemplo en memoria, los cambios no se guardan).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Candado opcional ────────────────────────────────────────────────────────
# Vacío = app abierta sin contraseña (configuración actual).
# Si algún día ponés una clave acá, la app pide esa clave una vez por
# dispositivo y se acuerda por 1 año.
CRM_PASSWORD=

# ── Bot de Telegram de "Por hacer" ──────────────────────────────────────────
# Vacías = sin bot; la pantalla Por hacer anda igual, anotando a mano.
# Cómo conectarlo: README → "Por hacer, desde Telegram".
TELEGRAM_BOT_TOKEN=
# Tu id de Telegram. Si no lo sabés, escribile al bot y te lo contesta.
TELEGRAM_CHAT_ID=
# Para entender audios.
OPENAI_API_KEY=
# Opcional: parte cada audio en varios pendientes. Sin esto entra entero.
ANTHROPIC_API_KEY=
