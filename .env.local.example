# ── Supabase ────────────────────────────────────────────────────────────────
# Copiá este archivo a .env.local y pegá los valores de tu proyecto.
# Los encontrás en: Supabase → Project Settings → API
#
# Mientras estas dos variables estén vacías, el CRM arranca en MODO DEMO
# (datos de ejemplo en memoria, los cambios no se guardan).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Candado opcional ────────────────────────────────────────────────────────
# Vacío = app abierta sin contraseña (configuración actual).
# Si algún día ponés una clave acá, la app pide esa clave una vez por
# dispositivo y se acuerda por 1 año.
CRM_PASSWORD=
